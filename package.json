{
  "name": "lupinum-colors",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://colors.lupinum.com/",
  "bugs": {
    "url": "https://github.com/lupinum-dev/lupinum-colors/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lupinum-dev/lupinum-colors.git"
  },
  "type": "module",
  "scripts": {
    "audit:all": "pnpm audit",
    "dev": "vp dev",
    "build": "run-p type-check reference:check \"build-only {@}\" --",
    "preview": "vp preview",
    "build-only": "run-s build:client build:ssr prerender",
    "build:client": "vp build",
    "build:ssr": "vp build --ssr src/entry-server.ts --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "palette": "node --import tsx src/bin.ts",
    "reference:build": "node --import tsx scripts/build-reference.ts",
    "reference:check": "node --import tsx scripts/build-reference.ts --check",
    "check": "vp check --no-fmt",
    "test": "vp test",
    "type-check": "vue-tsc --build",
    "format": "vp fmt",
    "docs:build": "pnpm build",
    "verify": "run-s check test build",
    "release:verify": "run-s audit:all verify"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/vue": "^1.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/server-renderer": "^3.5.42",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.11.1",
    "npm-run-all2": "^9.0.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-plus": "0.3.0",
    "vue-tsc": "^3.3.7",
    "yaml": "2.9.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.12.0 || ^26.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
